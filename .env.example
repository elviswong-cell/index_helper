# ---------------------------------------------------------------------------
# Firebase (Web app config)
# Firebase Console → Project settings → Your apps → SDK setup and configuration
# These are NEXT_PUBLIC_* and are exposed to the browser by design.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Admin access
# Comma-separated Firebase Auth UIDs granted admin access to /admin.
# e.g. NEXT_PUBLIC_ADMIN_UIDS=abc123uid,def456uid
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_UIDS=

# ---------------------------------------------------------------------------
# Email (Resend) — server-side only, used by /api/send-confirmation and
# /api/send-invoice. Never prefix these with NEXT_PUBLIC_.
# Without RESEND_API_KEY those routes log an error and skip sending.
# RESEND_FROM_EMAIL defaults to onboarding@resend.dev when unset.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
