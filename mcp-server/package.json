{
  "name": "helper-recruitment-mcp-server",
  "version": "1.0.0",
  "description": "MCP server giving an LLM admin control over the Helper Recruitment platform's Firestore data (tasks, registrations, tutors, invoices).",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "firebase-admin": "^12.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
